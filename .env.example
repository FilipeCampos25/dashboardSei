SEI_URL=
SEI_USERNAME=
SEI_PASSWORD=
# Bloqueia driver, login, navegacao e chamadas de rede quando true.
# O ambiente tem precedencia sobre este arquivo; use true em testes e reprocessamentos offline.
OFFLINE_ONLY=false
HEADLESS=false
TIMEOUT_SECONDS=20
MANUAL_LOGIN=true
MANUAL_LOGIN_WAIT_SECONDS=120
DEBUG=false
OUTPUT_DIR=output
REPORT_NAME=report.json
LOG_LEVEL=INFO
DESCRICOES_BUSCA=X|X|X
DESCRICOES_MATCH_MODE=contains
EXPORT_RAW_FIELDS_CSV=1
TESSERACT_CMD=
POPPLER_PATH=
DOCUMENT_TYPES=pt,act
# Sidecar V2 continua opt-in; enforcement: off (default), warn ou error.
V2_DUAL_WRITE=false
PROVENANCE_ENFORCEMENT_MODE=off
